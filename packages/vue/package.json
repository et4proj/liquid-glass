{
  "name": "@et4proj/liquid-glass-vue",
  "version": "0.1.0",
  "description": "Vue 绑定层：liquidGlassVue 插件 / GlassSurface / useGlass / v-glass 指令（架构 §8，语义对齐 react 绑定层）",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/liquid-glass-vue.cjs",
  "module": "./dist/liquid-glass-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/liquid-glass-vue.js",
      "require": "./dist/liquid-glass-vue.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@et4proj/liquid-glass-core": "workspace:*",
    "@et4proj/liquid-glass-web": "workspace:*"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
