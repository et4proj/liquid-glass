{
  "name": "@et4proj/liquid-glass-adapter-vant",
  "version": "0.1.0",
  "description": "Vant 4 玻璃适配数据包：类名表面映射 + CSS 补丁（纯 JSON-safe manifest，设计见 docs/proposals/adapter-system-design.md）",
  "type": "module",
