{
  "name": "liquid-glass-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "pnpm build && playwright test",
    "e2e:only": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:css": "stylelint \"playground/**/*.{css,vue}\" --allow-empty-input",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "playground": "pnpm --filter @et4proj/liquid-glass-playground dev",
    "playground:antd-mobile": "pnpm --filter @et4proj/liquid-glass-playground-antd-mobile dev",
    "playground:workbench": "pnpm --filter @et4proj/liquid-glass-playground-workbench dev",
    "playground:vant": "pnpm --filter @et4proj/liquid-glass-playground-vant dev",
    "playground:all": "pnpm --parallel --filter \"./playground/*\" dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.14.0"
}
